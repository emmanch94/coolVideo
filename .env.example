# --- Clerk (https://dashboard.clerk.com -> API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Supabase (Project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Higgsfield (https://cloud.higgsfield.ai -> API keys) ---
# Either HF_KEY="key:secret" or the two variables below.
HF_API_KEY=
HF_API_SECRET=
# Optional overrides
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_IMAGE_MODEL=bytedance/seedream/v4/text-to-image
HIGGSFIELD_VIDEO_MODEL=higgsfield-ai/dop/standard
# Set to "true" to fake generations (placeholder media) while building the UI.
HIGGSFIELD_MOCK=false
